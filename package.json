{
  "name": "system-design-playground",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:wasm": "asc src/wasm/assembly/index.ts -o src/wasm/build/sim_engine.wasm --optimize --converge --runtime stub && node -e \"const fs = require('fs'); const b64 = fs.readFileSync('src/wasm/build/sim_engine.wasm').toString('base64'); fs.writeFileSync('src/wasm/build/wasmBytecode.ts', 'export const WASM_BASE64 = \\\"' + b64 + '\\\";\\n');\"",
    "build": "npm run build:wasm && tsc && vite build",
    "lint": "tsc --noEmit",
    "server:collab": "node server/collabServer.mjs",
    "server:api": "node server/apiServer.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@clickhouse/client": "^1.23.1",
    "@xyflow/react": "^12.3.6",
    "bcryptjs": "^3.0.3",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.469.0",
    "lz-string": "^1.5.0",
    "pg": "^8.23.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.15.0",
    "ws": "^8.21.3",
    "y-websocket": "^3.1.0",
    "yjs": "^13.6.32"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/canvas-confetti": "^1.9.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/lz-string": "^1.5.0",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.3.4",
    "assemblyscript": "^0.28.20",
    "autoprefixer": "^10.6.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  }
}
